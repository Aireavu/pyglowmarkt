#!/usr/bin/env python3

import argparse
from glowmarkt.glowmarkt import BrightClient
import requests
import json

def get_org_details(client):
    """
    Fetches organisation and application details.
    """
    base_url = client.url
    
    # Fetch directory details
    directory_url = f"{base_url}directory"
    
    try:
        resp = client.session.get(directory_url, headers=client._get_headers())
        resp.raise_for_status()
        directories = resp.json()
        
        # Filter by provided directory_id if it exists
        if client.directory_id:
            filtered_dir = [d for d in directories if d['directoryId'] == client.directory_id]
            if filtered_dir:
                print(f"Directory Details (Filtered):")
                print(json.dumps(filtered_dir[0], indent=2))
            else:
                print(f"Directory with ID {client.directory_id} not found.")
        else:
            print("All Directories:")
            print(json.dumps(directories, indent=2))
            
    except requests.exceptions.HTTPError as e:
        print(f"Error fetching organisation details: {e}")
        print(e.response.text)

if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--app-id", help="Application ID (optional, defaults to retail app ID)")
    parser.add_argument("--app-key", required=True, help="Application Key")
    parser.add_argument("--app-secret", required=True, help="Application Secret")
    parser.add_argument("--directory-id", required=True, help="Directory ID")
    args = parser.parse_args()

    client = BrightClient(
        username=args.app_key,
        password=args.app_secret,
        app_id=args.app_id,
        directory_id=args.directory_id
    )

    get_org_details(client)
